<?xml version="1.0" encoding="UTF-8"?>
<!--
  Taha IPTV's Tizen manifest. Its own package id (TahaIPTV01): installs beside Free My TV, never over it.
  Privileges: the network (Xtream Codes servers, streams), the remote's extra keys (media, channel, colour, numbers),
  and the Key Manager (where saved passwords go when the TV offers it). AVPlay and the screensaver need none.
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://tahaiptv.app/tizen" version="0.3.0" viewmodes="maximized">
    <tizen:application id="TahaIPTV01.TahaIPTV" package="TahaIPTV01" required_version="3.0"/>
    <name>Taha IPTV</name>
    <description>Xtream Codes player</description>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/keymanager"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
